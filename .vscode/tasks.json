{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🧪Pytest/all",
      "type": "shell",
      "command": "uv run pytest --override-ini addopts='-q --tb=line -rfE --show-capture=no' -v -ra -W default",
      "group": {
        "kind": "test",
      },
      "problemMatcher": [
        "$python",
        {
          "owner": "pytest-warnings",
          "severity": "warning",
          "pattern": [
            {
              "regexp": "^\\s*((?:[A-Za-z]:\\\\|/).+?):(\\d+):\\s+(.*Warning:.*)$",
              "file": 1,
              "line": 2,
              "message": 3
            }
          ]
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "issue: info",
      "type": "shell",
      "command": "issuekit info",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
  ]
}
